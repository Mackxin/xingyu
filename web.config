<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS 的 MIME 映射（虚拟主机是 Microsoft-IIS/10.0）。

  为什么需要它：IIS 默认不认识 .apk，直接访问是 404.3（Not Found，不是 404）——
  文件明明传上去了却下不来，「App 更新包走镜像」就成了一句空话。
  .json / .md 同理，Windows 上有些主机把它们映射成了非 UTF-8 的类型。

  tools/deploy-ftp.py 全量同步时会重新写一份这个文件并上传，别手改线上那份。
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown; charset=utf-8" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
